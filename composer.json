{
    "name": "x-laravel/sluggable",
    "description": "Slugs for Eloquent models with Turkish-aware generation, race-safe uniqueness and a slug history that keeps old URLs working.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "slug", "sluggable", "history", "redirect"],
    "authors": [
        {
            "name": "Mehmet ÖĞMEN",
            "email": "www@mehmetogmen.com.tr",
            "homepage": "https://www.mehmetogmen.com.tr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "XLaravel\\Sluggable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XLaravel\\Sluggable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "XLaravel\\Sluggable\\SluggableServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
